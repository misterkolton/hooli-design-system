{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "tailwind.config.js",
    "css": "src/index.css",
    "baseColor": "slate",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "registries": {},
  "components": [
    {
      "name": "button",
      "path": "src/components/ui/button.tsx"
    },
    {
      "name": "card",
      "path": "src/components/ui/card.tsx"
    },
    {
      "name": "tabs",
      "path": "src/components/ui/tabs.tsx"
    },
    {
      "name": "scroll-area",
      "path": "src/components/ui/scroll-area.tsx"
    }
  ]
}
