{
  "private": true,
  "version": "0.0.1",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "common/*"
    ],
    "nohoist": [
      "**/babel-loader",
      "**/babel-loader/**",
      "**/webpack",
      "**/webpack/**",
      "**jest",
      "**jest/**"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@sendoutcards/prettier-config": "*",
    "@types/react": "^17.0.0",
    "@types/react-dom": "17.0.3",
    "@typescript-eslint/eslint-plugin": "^4.0.1",
    "@typescript-eslint/parser": "^4.0.1",
    "react": "^17.0.0",
    "react-country-flag": "3.0.2",
    "react-dom": "^17.0.2",
    "typescript": "4.7.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.11.4",
    "@testing-library/react": "^11.1.0",
    "@testing-library/user-event": "^12.1.10",
    "eslint": "7.32.0",
    "eslint-config-react-app": "*",
    "eslint-plugin-flowtype": "^5.2.0",
    "eslint-plugin-import": "^2.22.0",
    "eslint-plugin-jsx-a11y": "^6.3.1",
    "eslint-plugin-promise": "*",
    "eslint-plugin-react": "^7.20.6",
    "eslint-plugin-react-hooks": "^4.1.0",
    "husky": "^6.0.0",
    "lerna": "^3.22.1",
    "lint-staged": "*",
    "prettier": "*",
    "prompt": "^1.0.0"
  },
  "scripts": {
    "build": "lerna run build  --stream",
    "version": "lerna run build && lerna version",
    "clean": "rm -rf ./node_modules package-lock.json yarn.lock && yarn cache clean",
    "reinstall": "yarn clean && yarn install",
    "start-docs": "lerna run build --stream && lerna run start --stream",
    "start-docs:nobuild": "lerna run start --stream",
    "start-lib": "lerna run storybook --stream",
    "lint": "lerna run lint --stream",
    "publish": "lerna run publish",
    "prettier": "lerna run prettier --stream",
    "watch": "npm-watch",
    "create:lib": "node createComponent.js",
    "create:docs": "node createDocumentation.js",
    "build-storybook": "lerna run build-storybook",
    "prepublishOnly": "pinst --disable",
    "postpublish": "pinst --enable",
    "publish:ui": "cd packages/ui && npm publish"
  },
  "resolutions": {
    "webpack": "5.98.0",
    "@types/react": "17.0.83"
  },
  "prettier": "@sendoutcards/prettier-config",
  "packageManager": "yarn@1.22.19+sha1.4ba7fc5c6e704fce2066ecbfb0b0d8976fe62447"
}
